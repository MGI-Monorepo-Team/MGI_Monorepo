{
  "format": "cross_system_xp_scenarios",
  "schema_version": 2,
  "purpose": "CCAS policy boundary: duplicate-card XP stays at 1.0x even when Facilities and Coaches are upgraded. Shared by the Python tests and the C# tests.",
